{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resq-vision.invalid/contracts/lidar/scan.schema.json",
  "title": "Planar LiDAR scan",
  "description": "Proposed internal application model; not an approved wire protocol.",
  "x-status": "proposed",
  "x-owner": "server/acquisition",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1-draft"
    },
    "scan_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "frame_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "acquired_at": {
      "type": "object",
      "properties": {
        "clock_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "monotonic_ns": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "clock_id",
        "monotonic_ns"
      ],
      "additionalProperties": false
    },
    "quality": {
      "enum": [
        "valid",
        "degraded",
        "unknown"
      ]
    },
    "points": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "angle_rad": {
            "type": "number"
          },
          "range_m": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "offset_ns": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "angle_rad",
          "range_m",
          "offset_ns"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "scan_id",
    "frame_id",
    "acquired_at",
    "quality",
    "points"
  ],
  "additionalProperties": false
}
