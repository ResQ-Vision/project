{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resq-vision.invalid/contracts/ai/result.schema.json",
  "title": "Advisory inference result",
  "description": "Proposed internal application model; not an approved wire protocol.",
  "x-status": "proposed",
  "x-owner": "ai/events",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1-draft"
    },
    "event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "status": {
      "enum": [
        "completed",
        "unknown"
      ]
    },
    "label": {
      "enum": [
        "suspected_hazard",
        "no_hazard_detected",
        "unknown"
      ]
    },
    "scores": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    },
    "image_quality": {
      "enum": [
        "adequate",
        "inadequate",
        "unknown"
      ]
    },
    "model_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        {
          "type": "null"
        }
      ]
    },
    "runtime_version": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        {
          "type": "null"
        }
      ]
    },
    "latency_ms": {
      "type": "number",
      "minimum": 0
    },
    "reason": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "event_id",
    "status",
    "label",
    "scores",
    "image_quality",
    "model_id",
    "runtime_version",
    "latency_ms",
    "reason"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "unknown"
          }
        }
      },
      "then": {
        "properties": {
          "label": {
            "const": "unknown"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        }
      },
      "else": {
        "properties": {
          "model_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "runtime_version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "image_quality": {
            "const": "adequate"
          },
          "reason": {
            "type": "null"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "label": {
                  "enum": [
                    "suspected_hazard",
                    "no_hazard_detected"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "scores": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "minProperties": 1
                }
              }
            }
          }
        ]
      }
    }
  ]
}
