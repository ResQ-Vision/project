{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resq-vision.invalid/contracts/camera/capture-response.schema.json",
  "title": "Capture outcome",
  "description": "Proposed internal application model; not an approved wire protocol.",
  "x-status": "proposed",
  "x-owner": "camera/events",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1-draft"
    },
    "capture_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "status": {
      "enum": [
        "captured",
        "failed",
        "unavailable"
      ]
    },
    "captured_at": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "clock_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "monotonic_ns": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "clock_id",
            "monotonic_ns"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "image_ref": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        {
          "type": "null"
        }
      ]
    },
    "reason": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "capture_id",
    "status",
    "captured_at",
    "image_ref",
    "reason"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "captured"
          }
        }
      },
      "then": {
        "properties": {
          "image_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "reason": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "image_ref": {
            "type": "null"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        }
      }
    }
  ]
}
